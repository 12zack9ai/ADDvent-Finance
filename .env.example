# Copy to .env and fill in. Never commit .env - it holds live credentials.

# ---------------------------------------------------------------------------
# REQUIRED: Claude API key. Without this, documents cannot be read.
# Get one at https://console.anthropic.com -> API keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only needed if the key above is an ORGANISATION key rather than one scoped to
# a workspace. Simpler alternative: create a workspace-scoped key instead.
ANTHROPIC_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_NAME=Add Ventures Inc · Finance
BASE_URL=https://finance.addventuresinc.com

# ---------------------------------------------------------------------------
# Storage. DATA_DIR holds the SQLite database, uploaded documents and rendered
# PDFs. BACK THIS UP - it is the whole system's state.
# ---------------------------------------------------------------------------
DATA_DIR=/var/lib/finance-automation
# Leave DATABASE_URL blank to use SQLite inside DATA_DIR. Set a
# postgresql+psycopg://... URL if you outgrow it.
DATABASE_URL=

# ---------------------------------------------------------------------------
# PDF rendering. Leave blank to auto-detect; on Debian/Ubuntu install with
#   apt-get install -y chromium
# ---------------------------------------------------------------------------
CHROME_BINARY=

# ---------------------------------------------------------------------------
# MAILBOX — where invoices arrive
#
# Two options. Fill in ONE of them and set MAIL_ENABLED=true.
# Until then the app works fully by uploading documents.
#
# OPTION 1 (simple): IMAP — an ordinary mailbox on your own mail host, i.e. the
# kind you create in cPanel or Plesk. Nothing to register, nobody to ask.
#   - Create the address in your hosting control panel
#   - IMAP_HOST is usually mail.yourdomain.com (the panel tells you)
#   - Verify it before wiring up:  python scripts/test_mail.py
# ---------------------------------------------------------------------------
MAIL_ENABLED=false
# NOTE: on cPanel the incoming server is usually the BARE DOMAIN, not
# mail.<domain>. Check Email Accounts -> Connect Devices to be sure.
IMAP_HOST=mail.protectedharborinc.com
IMAP_PORT=993
IMAP_SSL=true
# The username is whatever the mail host authenticates on, and hosts disagree.
# On ours (Protected Harbor) it is the MAILBOX NAME only - "aifinance" - and
# sending the full address returns a bare "LOGIN failed." with no explanation.
# Plenty of other hosts want the full address. If login fails, try the other one.
IMAP_USER=aifinance
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---------------------------------------------------------------------------
# OPTION 2: Microsoft Graph — only if the mailbox is in Exchange / Microsoft 365.
# Needs an Entra ID app registration and admin consent; see app/mailbox.py.
# Leave blank if you are using IMAP above.
# ---------------------------------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=

# auto = use whichever of the two is filled in (IMAP wins). Or force: imap | graph
MAIL_BACKEND=auto
# Messages are moved here once every attachment on them has been filed.
MAIL_PROCESSED_FOLDER=Processed
MAIL_POLL_SECONDS=300

# ---------------------------------------------------------------------------
# Matching. How similar two line descriptions must be (0-100) to be treated as
# the same item when part numbers are missing or differ between documents.
# Raise it if unrelated lines get matched; lower it if obvious matches are missed.
# ---------------------------------------------------------------------------
FUZZY_THRESHOLD=88

# Model used to read documents.
EXTRACTION_MODEL=claude-opus-5

# --- asking the sender for a missing job number --------------------------
# Vendors routinely leave the job field blank. When neither the document nor
# the covering email says which job it is, the system can reply to the sender
# asking. Off by default: replying to people is the one thing this app does
# that leaves the building.
#
# SMTP settings fall back to the IMAP ones, which on ordinary mail hosting is
# the same mailbox and password - set these only if they differ.
ASK_FOR_JOB_NUMBER=false
# Who the app may email, comma separated. Leave blank and it uses the domain of
# our own mailbox, which means it can only ever write to us. Vendors are NOT
# reachable: staff forward a vendor's document in, and staff get asked which
# job it belongs to - which is the right person anyway, because they know and
# the vendor does not.
REPLY_DOMAINS=addventuresinc.com
SMTP_HOST=mail.protectedharborinc.com
SMTP_PORT=587
SMTP_USER=aifinance@addventuresinc.com
SMTP_PASSWORD=
SMTP_FROM=aifinance@addventuresinc.com

# ---------------------------------------------------------------------------
# JobNimbus - read only, and asked exactly one question: who is this job
# assigned to, so we know who to ask for a missing quote.
#
# When an invoice arrives on a job with no quote on file, the project manager
# named in JobNimbus gets one email asking them to forward the quotes. Off
# unless ASK_FOR_QUOTE is set, and it can only ever email a REPLY_DOMAINS
# address - a project manager is staff.
#
# The field names in app/jobnimbus.py are candidates, not confirmed: JobNimbus
# publishes a Postman collection rather than a specification. Run
#   scripts/jobnimbus_probe.py <a real job number>
# once against the real account and trim them to what actually comes back.
# ---------------------------------------------------------------------------
JOBNIMBUS_API_KEY=
ASK_FOR_QUOTE=false
